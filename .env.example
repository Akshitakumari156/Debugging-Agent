# =============================================================================
# AutoDebug — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# --- LLM API Keys ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...          # Optional: used if MODEL=claude
GROQ_API_KEY=gsk-...                  # Optional: used if MODEL=llama3-70b-8192
OLLAMA_BASE_URL=http://localhost:11434 # Optional: used for local free inference
MODEL=llama3-70b-8192                 # gpt-4o | claude-3-5-sonnet-20241022 | llama3-70b-8192 | ollama/llama3

# --- GitHub Integration ---
GITHUB_TOKEN=ghp_...               # PAT with: repo, pull_requests scopes
GITHUB_BOT_NAME=autodebug-bot
GITHUB_BOT_EMAIL=autodebug@yourdomain.com

# --- Database ---
DATABASE_URL=postgresql+asyncpg://autodebug:autodebug@localhost:5432/autodebug
POSTGRES_USER=autodebug
POSTGRES_PASSWORD=autodebug
POSTGRES_DB=autodebug

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Sandbox Configuration ---
SANDBOX_CPU_LIMIT=1.0                 # CPU cores per container
SANDBOX_MEMORY_LIMIT=512m             # Memory per container
SANDBOX_TIMEOUT=300                   # Max seconds per task (5 min)
SANDBOX_IMAGE=autodebug-sandbox:latest
SANDBOX_NETWORK=autodebug-net         # Isolated docker network

# --- Agent Configuration ---
MAX_FIX_ITERATIONS=3                  # Max reflection/retry cycles
LOG_LEVEL=INFO

# --- Backend ---
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
SECRET_KEY=change-me-in-production-use-a-long-random-string

# --- Frontend ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
